{
  "project_name": "my-graph-api",
  "project_slug": "{{ cookiecutter.project_name | replace('-', '_') }}",
  "project_description": "LangGraph workflows served through an OpenAI-compatible API",
  "author": "Your Name",
  "email": "you@example.com",
  "python_version": [
    "3.13",
    "3.14",
    "3.12",
    "3.11"
  ],
  "license": [
    "MIT",
    "Proprietary"
  ],
  "ci": [
    "github",
    "gitlab"
  ],
  "__prompts__": {
    "project_name": "Project name (lowercase words separated by hyphens)",
    "project_slug": "Python package name",
    "project_description": "Short description",
    "author": "Author name",
    "email": "Author email",
    "python_version": "Python version",
    "license": "License",
    "ci": "CI provider"
  },
  "_extensions": [
    "lgos_template_extensions.UnicodeJSONExtension"
  ],
  "_copy_without_render": [
    ".agents/CODE_STYLE.md"
  ],
  "_jinja2_env_vars": {
    "trim_blocks": true,
    "lstrip_blocks": true
  }
}
