# Upstream model called inside the graphs. Environment values override this file.
APP_OPENAI_BASE_URL=https://api.openai.com/v1
APP_OPENAI_API_KEY=TO_BE_FILLED
APP_OPENAI_MODEL=gpt-5.4-mini

# LGOS server. Without LGOS_POSTGRES_URI, interrupt state lives in process
# memory; Compose points the containers at its PostgreSQL service.
LGOS_HOST=127.0.0.1
LGOS_PORT=8000
# Single-quote JSON lists, e.g. '["https://app.example.com"]'; Just and uv
# strip unquoted double quotes.
LGOS_CORS_ORIGINS=[]
# LGOS_POSTGRES_URI=postgresql://app:app@localhost:5433/app
# Empty keeps `just run` background Responses in its process, and containers
# reject them. Set hatchet to run them in the worker (`just worker` or Compose).
LGOS_BACKGROUND=
LGOS_OPENAI_API_DOCS_ENABLED=False

# The example clients target this application, not the upstream model provider.
CLIENT_BASE_URL=http://localhost:8000/v1
CLIENT_API_KEY=DUMMY

# Local PostgreSQL from `just postgres` and Compose.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5433
DOCKER_POSTGRES_URI=postgresql://app:app@postgres:5432/app
# Add `background` to also start the Hatchet worker container.
COMPOSE_PROFILES=

# Hatchet tenant shared by the API and worker when LGOS_BACKGROUND=hatchet.
HATCHET_CLIENT_TOKEN=TO_BE_FILLED
HATCHET_CLIENT_NAMESPACE={{ cookiecutter.project_name }}
# The SDK reads endpoints from the token. Uncomment for a self-hosted service.
# HATCHET_CLIENT_HOST_PORT=hatchet.example.com:443
# HATCHET_CLIENT_SERVER_URL=https://hatchet.example.com
# HATCHET_CLIENT_TLS_STRATEGY=tls

# An existing Langfuse project, reachable from the API and worker.
LGOS_ENABLE_LANGFUSE=False
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=TO_BE_FILLED
LANGFUSE_SECRET_KEY=TO_BE_FILLED

# OTLP export for `just run-otel` and the Compose OpenTelemetry overlay.
OTEL_SERVICE_NAME={{ cookiecutter.project_name }}
OTEL_RESOURCE_ATTRIBUTES=service.namespace={{ cookiecutter.project_name }},deployment.environment.name=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_INSECURE=True
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_PYTHON_LOG_AUTO_INSTRUMENTATION=True
OTEL_PYTHON_LOG_CORRELATION=True
OTEL_PYTHON_LOG_HANDLER_LEVEL=info
OTEL_COLLECTOR_UPSTREAM=http://host.docker.internal:4318
