DEMO_API_FILES_PORT=8000
DEMO_API_FILES_BUCKET=lgos-files-api
DEMO_API_FILES_S3_ENDPOINT=https://s3.example.com
DEMO_API_FILES_AWS_ACCESS_KEY_ID=TO_BE_FILLED
DEMO_API_FILES_AWS_SECRET_ACCESS_KEY=TO_BE_FILLED
DEMO_API_FILES_AWS_DEFAULT_REGION=eu-west-1
# Documents are extracted in the service process, up to this many at once.
DEMO_API_FILES_MAX_CONCURRENT_EXTRACTIONS=2
# xberg's threads; size them to the CPUs the process may use, not the host's cores.
DEMO_API_FILES_EXTRACTION_THREADS=1
# Below Open WebUI's 300-second wait, which also covers the wait for a slot.
DEMO_API_FILES_EXTRACTION_TIMEOUT_SECONDS=240
# 512 MiB, OpenAI's limit; uploads are spooled to /tmp first.
DEMO_API_FILES_MAX_UPLOAD_BYTES=536870912
