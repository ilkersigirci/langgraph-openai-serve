DEMO_IMAGE_TAG=latest
# Match the host user that owns docker/volumes/.
PUID=1000
PGID=1000
RESTART_POLICY=unless-stopped

######### HOST PORTS #########
LGOS_GATEWAY_PORT=3000
LGOS_DB_PORT=3001
LGOS_CHAINLIT_PORT=3002
LGOS_OPENWEBUI_PORT=3003
LGOS_DEMO_API_PORT=3004
LGOS_FILES_PORT=3006

# Demo-only credentials for the read-only PostgreSQL MCP path.
LGOS_MCP_DB_PASSWORD=lgos-mcp
LGOS_MCP_AUTH_TOKEN=lgos-demo-only-mcp-token
DEMO_GATEWAY_HOST_URL=http://localhost:${LGOS_GATEWAY_PORT}

######### OPENTELEMETRY #########
# Used only with: just demo/compose --otel (optionally with --dev)
# The endpoint is the OTLP/HTTP base URL of the host's Collector gateway.
OTEL_COLLECTOR_GATEWAY_ENDPOINT=
OTEL_DEPLOYMENT_ENVIRONMENT=production
OTEL_SERVICE_NAMESPACE=lgos
# Host identity added by the local Collector; set this per machine.
OTEL_HOST_NAME=

######### LGOS API #########
LGOS_OPENAI_API_DOCS_ENABLED=False
LGOS_ENABLE_LANGFUSE=False
# Reject unsafe legacy checkpoint object deserialization.
LANGGRAPH_STRICT_MSGPACK=True
# `lgos serve` settings for the demo API and its worker. Local browser demos may
# use any origin; deployments must list their trusted origins instead.
LGOS_CORS_ORIGINS='["*"]'
LGOS_POSTGRES_URI=postgresql://lgos:lgos@localhost:${LGOS_DB_PORT}/lgos
# Paused interrupt runs are deleted after this TTL (30 days), checked on this interval.
LGOS_INTERRUPT_TTL_MINUTES=43200
LGOS_INTERRUPT_SWEEP_INTERVAL_MINUTES=5

# Used only when LGOS_ENABLE_LANGFUSE is true.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=TO_BE_FILLED
LANGFUSE_SECRET_KEY=TO_BE_FILLED

######### DEMO API #########
# Graphs call these models through the selected gateway with
# OPENAI_GATEWAY_API_KEY. The bundled gateways forward them to the OpenAI API;
# with an external gateway, set the IDs it registers. Graphs built on Chat
# Completions use the first model, which must call tools without
# reasoning-specific parameters. The advanced, file-input, and server-tool
# graphs and Codex use the Responses model; the simple graph also offers it
# through Chat Completions.
DEMO_API_OPENAI_CHAT_COMPLETIONS_MODEL=openai/gpt-4.1-mini
DEMO_API_OPENAI_RESPONSES_MODEL=openai/gpt-6-luna
# The vector store uses the same gateway's OpenAI passthrough. A blank ID
# disables shared-knowledge search and saving.
DEMO_API_VECTOR_STORE_ID=
DEMO_API_OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
DEMO_API_WEB_SEARCH_BACKEND=http
DEMO_API_WEB_SEARCH_URL=https://searxng.example.com/search
DEMO_API_FILES_BASE_URL=http://localhost:${LGOS_FILES_PORT}/v1

######### OPTIONAL BACKGROUND RESPONSES #########
# Set hatchet and add `background` to COMPOSE_PROFILES to run the worker.
LGOS_BACKGROUND=none
LGOS_HATCHET_WORKER_SLOTS=4

######### HATCHET #########
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_NAMESPACE=lgos-demo
# Native SDK exclusions keep request bodies and caller metadata out of spans.
HATCHET_CLIENT_OPENTELEMETRY_EXCLUDED_ATTRIBUTES='["payload","additional_metadata"]'

######### FILES API #########
DEMO_API_FILES_BUCKET=lgos-files-api
DEMO_API_FILES_S3_ENDPOINT=https://s3.example.com
DEMO_API_FILES_AWS_ACCESS_KEY_ID=TO_BE_FILLED
DEMO_API_FILES_AWS_SECRET_ACCESS_KEY=TO_BE_FILLED
DEMO_API_FILES_AWS_DEFAULT_REGION=eu-west-1

######### OPENAI GATEWAY #########

# Shared by all gateway modes. Keep these variables defined.
OPENAI_GATEWAY_TYPE=bifrost
COMPOSE_PROFILES=${OPENAI_GATEWAY_TYPE}
# Gateway root without a trailing slash; Open WebUI's MCP connection appends /mcp.
OPENAI_GATEWAY_BASE_URL=http://lgos-${OPENAI_GATEWAY_TYPE}:4000
# One credential for model discovery, Responses, Files, speech, and MCP in both
# UIs, and for the model calls of the graph and coding-agent APIs.
# Bifrost virtual keys require the sk-bf- prefix; the same value is valid for LiteLLM.
OPENAI_GATEWAY_API_KEY=sk-bf-lgos-demo-only-key

# Operator-only model sync. For external LiteLLM, use its native admin URL
# and export its admin key from the deployment environment, not the UI .env.
LITELLM_SYNC_BASE_URL=${OPENAI_GATEWAY_BASE_URL}
LITELLM_MASTER_KEY=${OPENAI_GATEWAY_API_KEY}

# Speech-to-text and text-to-speech models both UIs call through the same
# gateway and credential. The bundled gateways forward these IDs to the OpenAI
# API; with an external gateway, set the IDs it registers. Chainlit hides its
# microphone or read-aloud button when the matching model is empty.
DEMO_AUDIO_STT_MODEL=openai/gpt-4o-mini-transcribe
DEMO_AUDIO_TTS_MODEL=openai/gpt-4o-mini-tts
DEMO_AUDIO_TTS_VOICE=alloy
# Root, without /v1, of the OpenAI-compatible upstream behind every openai/*
# model and the vector store. LiteLLM reads the URL here; Bifrost reads it from
# DEMO_BIFROST_CONFIG. The key must keep files and vector stores in one account.
OPENAI_UPSTREAM_BASE_URL=https://api.openai.com
OPENAI_UPSTREAM_API_KEY=TO_BE_FILLED

### BIFROST ###
# Default gateway.
# Bifrost resolves no environment reference in a provider base_url. For another
# upstream, copy config.json to the gitignored config.local.json beside it and
# set ../configs/bifrost/config.local.json; paths are relative to docker/apps/.
DEMO_BIFROST_CONFIG=../configs/bifrost/config.json

### LITELLM ###
DEMO_LITELLM_IMAGE=ghcr.io/ilkersigirci/homeserver-litellm:1.104.0@sha256:2f5faa7035941ae1343eb4625e903e5662ec8426bdd596cb64d4b3fbd21b7a6c
# Set OPENAI_GATEWAY_TYPE=litellm above.

### EXTERNAL LITELLM ###
## Overrides the above values.
# OPENAI_GATEWAY_TYPE=litellm
# COMPOSE_PROFILES=
# OPENAI_GATEWAY_BASE_URL=https://litellm.example.com
# DEMO_GATEWAY_HOST_URL=https://litellm.example.com
# OPENAI_GATEWAY_API_KEY=TO_BE_FILLED

######### CHAINLIT #########
CHAINLIT_APP_ROOT=src/lgos_chainlit
CHAINLIT_AUTH_SECRET=TO_BE_FILLED
DATABASE_URL=postgresql://lgos:lgos@localhost:${LGOS_DB_PORT}/lgos

# Native Chainlit element storage (required for generated-file thread resume).
BUCKET_NAME=lgos-chainlit
APP_AWS_ACCESS_KEY=TO_BE_FILLED
APP_AWS_SECRET_KEY=TO_BE_FILLED
APP_AWS_REGION=eu-west-1
DEV_AWS_ENDPOINT=https://s3.example.com
STORAGE_EXPIRY_TIME=3600

### OPTIONAL CHAINLIT OAUTH ###
# Fill these values when DEMO_CHAINLIT_LOGIN_TYPE=oauth. Empty values are ignored.
CHAINLIT_URL=
OAUTH_GENERIC_CLIENT_ID=
OAUTH_GENERIC_CLIENT_SECRET=
DEMO_CHAINLIT_OAUTH_ISSUER=
DEMO_CHAINLIT_OAUTH_CLIENT_AUTH_METHOD=client_secret_basic
DEMO_CHAINLIT_OAUTH_ENCRYPTION_KEYS=
# Scopes are requested during OAuth login even when token forwarding is disabled.
# For login only, use "openid profile email groups"; remove gateway scopes such as
# llm:invoke, which can prevent sign-in if unsupported by the requested resource.
OAUTH_GENERIC_SCOPES=
OAUTH_GENERIC_NAME=generic
OAUTH_PROMPT=
OAUTH_GENERIC_PROMPT=
# Identity is always the verified OIDC sub claim. Endpoints come from discovery.
# Delegated auth needs a Fernet key from demo/ui/chainlit_ui (see its README).
# Match the registered client's auth method; client_secret_post is also supported.
# With token forwarding enabled, use the LiteLLM SSO endpoint.
# Delegated authorization makes Chainlit use the signed-in user's token and
# disables its static native MCP connection. The shared stack key remains
# available to Open WebUI and the gateway services.
# Set resource only if the provider uses
# RFC 8707 (e.g. PocketID's API resource); otherwise configure its API audience there.
DEMO_CHAINLIT_OAUTH_RESOURCE=
# OPENAI_GATEWAY_BASE_URL=https://litellm-sso.example.com
# DEMO_GATEWAY_HOST_URL=https://litellm-sso.example.com

### CHAINLIT UTILS ###
CHAINLIT_UTILS_MIGRATIONS_TABLE=_lgos_chainlit_schema_migrations
CHAINLIT_UTILS_MODEL_CONTEXT_EXCLUDED_KEY=lgos_chainlit.exclude_from_model_context

### DEMO SPECIFIC ###
DEMO_CHAINLIT_LOGIN_TYPE=mock
DEMO_CHAINLIT_ENABLE_OAUTH_TOKEN_FORWARDING=False
DEMO_CHAINLIT_STATUS_DISPLAY=steps

######### CODING-AGENT API #########
# Codex calls this model through the selected gateway's Responses route.
DEMO_CODING_AGENT_MODEL=${DEMO_API_OPENAI_RESPONSES_MODEL}
DEMO_CODING_AGENT_TIMEOUT_SECONDS=600

######### INTEGRATION TESTS #########
DEMO_API_TEST_POSTGRES_URI=${LGOS_POSTGRES_URI}
DEMO_TEST_DIRECT_BASE_URL=http://localhost:${LGOS_DEMO_API_PORT}/v1
DEMO_TEST_FILES_BASE_URL=${DEMO_API_FILES_BASE_URL}
DEMO_TEST_BIFROST_BASE_URL=${DEMO_GATEWAY_HOST_URL}/openai/v1
DEMO_TEST_BIFROST_CATALOG_BASE_URL=${DEMO_GATEWAY_HOST_URL}/v1
DEMO_TEST_LITELLM_BASE_URL=${DEMO_GATEWAY_HOST_URL}/v1

######### OPEN WEBUI #########
DEMO_OPENWEBUI_URL=http://localhost:${LGOS_OPENWEBUI_PORT}
DEMO_OPENWEBUI_ADMIN_EMAIL=lgos@example.com
DEMO_OPENWEBUI_ADMIN_PASSWORD=lgos
# Demo-only key; replace it with the output of: openssl rand -base64 32
DEMO_OPENWEBUI_SECRET_KEY=bGdvcy1kZW1vLW9ubHktc2VjcmV0LWNoYW5nZS1tZSE=
