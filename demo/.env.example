DEMO_IMAGE_TAG=latest
# Match the host user that owns docker/volumes/.
PUID=1000
PGID=1000

######### OPENTELEMETRY #########
# Used only with: make compose-otel or make compose-otel-dev
# The endpoint is the OTLP/HTTP base URL of the host's Collector gateway.
OTEL_COLLECTOR_GATEWAY_ENDPOINT=
OTEL_DEPLOYMENT_ENVIRONMENT=production
OTEL_SERVICE_NAMESPACE=lgos
# Host identity added by the local Collector; set this per machine.
OTEL_HOST_NAME=
# The OTEL Compose overlay uses an always-on sampler and exports all traces.
# Route UI inference through the public Traefik endpoint to include the edge
# proxy in each distributed trace. Leave unset for direct Compose networking.
# DEMO_BIFROST_BASE_URL=https://lgos-bifrost.example.com

######### LGOS API #########
LGOS_OPENAI_API_PREFIX=/v1
LGOS_OPENAI_API_DOCS_ENABLED=False
LGOS_ENABLE_LANGFUSE=False
# Reject unsafe legacy checkpoint object deserialization.
LANGGRAPH_STRICT_MSGPACK=true

# Used only when LGOS_ENABLE_LANGFUSE is true.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=TO_BE_FILLED
LANGFUSE_SECRET_KEY=TO_BE_FILLED

######### DEMO API #########
DEMO_API_OPENAI_API_KEY=TO_BE_FILLED
DEMO_API_OPENAI_BASE_URL=https://api.openai.com/v1
DEMO_API_OPENAI_MODEL=gpt-5.4-mini
DEMO_API_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DEMO_API_POSTGRES_URI=postgresql://lgos:lgos@localhost:3001/lgos

######### CHAINLIT #########
CHAINLIT_APP_ROOT=src/lgos_chainlit
CHAINLIT_AUTH_SECRET=TO_BE_FILLED
DATABASE_URL=postgresql://lgos:lgos@localhost:3001/lgos

### OPTIONAL CHAINLIT OAUTH ###
# OAUTH_GENERIC_CLIENT_ID=TO_BE_FILLED
# OAUTH_GENERIC_CLIENT_SECRET=TO_BE_FILLED
# OAUTH_GENERIC_AUTH_URL=https://pocketid.example.com/authorize
# OAUTH_GENERIC_TOKEN_URL=https://pocketid.example.com/api/oidc/token
# OAUTH_GENERIC_USER_INFO_URL=https://pocketid.example.com/api/oidc/userinfo
# OAUTH_GENERIC_SCOPES="openid profile email groups"
# OAUTH_GENERIC_NAME=PocketID
# OAUTH_GENERIC_USER_IDENTIFIER=sub

### CHAINLIT UTILS ###
CHAINLIT_UTILS_MIGRATIONS_TABLE=_lgos_chainlit_schema_migrations
CHAINLIT_UTILS_MODEL_CONTEXT_EXCLUDED_KEY=lgos_chainlit.exclude_from_model_context

### DEMO SPECIFIC ###
# Standalone Chainlit uses these endpoints. Compose derives both endpoints from
# DEMO_BIFROST_BASE_URL above.
DEMO_CHAINLIT_OPENAI__BASE_URL=http://localhost:3004/v1
DEMO_CHAINLIT_OPENAI__API_KEY=DUMMY
# For the Compose Bifrost pass-through instead of the direct local API:
# DEMO_CHAINLIT_OPENAI__BASE_URL=http://localhost:3000/openai_passthrough/v1
# DEMO_CHAINLIT_OPENAI__CATALOG_BASE_URL=http://localhost:3000/v1
DEMO_CHAINLIT_HITL_MODEL=interruptible-approval
DEMO_CHAINLIT_LOGIN_TYPE=mock
DEMO_CHAINLIT_UI_FILE=simple

######### OPEN WEBUI #########
# These endpoints are used by the standalone workspace-model sync command.
# The Open WebUI container derives both endpoints from DEMO_BIFROST_BASE_URL.
DEMO_OPENWEBUI_URL=http://localhost:3003
DEMO_OPENWEBUI_ADMIN_EMAIL=lgos@example.com
DEMO_OPENWEBUI_ADMIN_PASSWORD=lgos
DEMO_OPENWEBUI_SECRET_KEY=lgos-demo-only-secret
DEMO_OPENWEBUI_OPENAI_BASE_URL=http://localhost:3000/openai_passthrough/v1
DEMO_OPENWEBUI_OPENAI_CATALOG_BASE_URL=http://localhost:3000/v1
DEMO_OPENWEBUI_API_KEY=DUMMY
