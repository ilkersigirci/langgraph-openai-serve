DEMO_API_VECTOR_STORE_ID=
DEMO_API_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DEMO_API_POSTGRES_URI=postgresql://lgos:lgos@localhost:3001/lgos
DEMO_API_FILES_BASE_URL=http://localhost:3006/v1
DEMO_API_BACKGROUND_ENABLED=false
DEMO_API_BACKGROUND_ADMISSION_CAPACITY=100
DEMO_API_BACKGROUND_RESULT_RETENTION_SECONDS=3600
DEMO_API_BACKGROUND_STORED_RESULT_RETENTION_SECONDS=2592000
