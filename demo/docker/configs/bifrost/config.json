{
  "$schema": "https://www.getbifrost.ai/schema",
  "providers": {
    "lgos-a": {
      "keys": [
        {
          "name": "lgos-a",
          "value": "DUMMY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://lgos-demo-api-a:8000",
        "allow_private_network": true
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "list_models": true,
          "chat_completion": true,
          "chat_completion_stream": true,
          "passthrough": true,
          "passthrough_stream": true
        }
      }
    },
    "lgos-b": {
      "keys": [
        {
          "name": "lgos-b",
          "value": "DUMMY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://lgos-demo-api-b:8000",
        "allow_private_network": true
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "list_models": true,
          "chat_completion": true,
          "chat_completion_stream": true,
          "passthrough": true,
          "passthrough_stream": true
        }
      }
    }
  },
  "config_store": {
    "enabled": false
  },
  "client": {
    "header_filter_config": {
      "allowlist": ["baggage", "traceparent", "tracestate"]
    }
  },
  "plugins": [
    {
      "enabled": true,
      "name": "otel",
      "config": {
        "service_name": "lgos-bifrost",
        "collector_url": "http://lgos-otel-collector:4318/v1/traces",
        "trace_type": "genai_extension",
        "protocol": "http",
        "disable_content_logging": true,
        "plugin_span_filter": {
          "mode": "exclude",
          "plugins": [
            "compat",
            "logging",
            "model-catalog-resolver",
            "otel",
            "telemetry"
          ]
        }
      }
    }
  ]
}
