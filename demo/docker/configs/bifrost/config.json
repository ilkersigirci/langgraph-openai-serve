{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {
    "enforce_auth_on_inference": true,
    "header_filter_config": {
      "allowlist": [
        "idempotency-key",
        "traceparent",
        "tracestate",
        "user-agent"
      ]
    }
  },
  "mcp": {
    "client_configs": [
      {
        "name": "lgos_postgres",
        "endpoint_slug": "lgos-postgres-source",
        "connection_type": "http",
        "connection_string": "http://lgos-postgres-mcp:8080/mcp",
        "auth_type": "headers",
        "headers": {
          "Authorization": "env.LGOS_MCP_AUTH_HEADER"
        },
        "tools_to_execute": [
          "count_chainlit_users",
          "list_chainlit_conversation_counts",
          "summarize_chainlit_activity",
          "list_chainlit_activity_by_profile",
          "summarize_lgos_interrupted_runs",
          "list_lgos_interrupted_runs"
        ]
      }
    ],
    "virtual_mcps": [
      {
        "id": 1,
        "name": "LGOS PostgreSQL Reports",
        "endpoint_slug": "lgos-postgres",
        "description": "Fixed read-only reports for live LGOS and Chainlit data",
        "enabled": true,
        "virtual_key_ids": ["lgos-demo"],
        "tools": [
          {
            "mcp_client_name": "lgos_postgres",
            "tool_names": [
              "count_chainlit_users",
              "list_chainlit_conversation_counts",
              "summarize_chainlit_activity",
              "list_chainlit_activity_by_profile",
              "summarize_lgos_interrupted_runs",
              "list_lgos_interrupted_runs"
            ]
          }
        ]
      }
    ],
    "tool_manager_config": {
      "tool_execution_timeout": "15s",
      "disable_auto_tool_inject": true
    }
  },
  "governance": {
    "virtual_keys": [
      {
        "id": "lgos-demo",
        "name": "LGOS demo clients",
        "description": "Demo UI access to LGOS providers and read-only PostgreSQL MCP tools",
        "value": "env.BIFROST_DEMO_VIRTUAL_KEY",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "openai",
            "allowed_models": ["background-mock"],
            "key_ids": ["*"],
            "weight": 1.0
          },
          {
            "provider": "lgos-a",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          },
          {
            "provider": "lgos-b",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          },
          {
            "provider": "lgos-files",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          }
        ]
      }
    ]
  },
  "providers": {
    "openai": {
      "keys": [
        {
          "name": "lgos-background",
          "value": "DUMMY",
          "models": ["background-mock"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://lgos-demo-api-a:8000",
        "allow_private_network": true
      }
    },
    "lgos-a": {
      "keys": [
        {
          "name": "lgos-a",
          "value": "DUMMY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://lgos-demo-api-a:8000",
        "allow_private_network": true
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "list_models": true,
          "responses": true,
          "responses_stream": true,
          "responses_retrieve": true,
          "responses_cancel": true,
          "passthrough": true,
          "passthrough_stream": true
        }
      }
    },
    "lgos-b": {
      "keys": [
        {
          "name": "lgos-b",
          "value": "DUMMY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://lgos-demo-api-b:8000",
        "allow_private_network": true
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "list_models": true,
          "responses": true,
          "responses_stream": true,
          "responses_retrieve": true,
          "responses_cancel": true,
          "passthrough": true,
          "passthrough_stream": true
        }
      }
    },
    "lgos-files": {
      "keys": [
        {
          "name": "lgos-files",
          "value": "DUMMY",
          "models": ["*"],
          "weight": 1.0,
          "use_for_batch_api": true
        }
      ],
      "network_config": {
        "base_url": "http://lgos-files-api:8000",
        "allow_private_network": true
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "file_upload": true,
          "file_list": true,
          "file_retrieve": true,
          "file_delete": true,
          "file_content": true
        }
      }
    }
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/tmp/config.db"
    }
  },
  "plugins": [
    {
      "enabled": true,
      "name": "otel",
      "config": {
        "service_name": "lgos-bifrost",
        "collector_url": "http://lgos-otel-collector:4318/v1/traces",
        "trace_type": "genai_extension",
        "protocol": "http",
        "disable_content_logging": true,
        "plugin_span_filter": {
          "mode": "exclude",
          "plugins": [
            "compat",
            "logging",
            "model-catalog-resolver",
            "otel",
            "telemetry"
          ]
        }
      }
    }
  ]
}
