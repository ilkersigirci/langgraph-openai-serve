# Start one Compose service; add --dev to build this checkout or --wait to detach.
[arg('dev', long, value='true')]
[arg('wait', long, value='true')]
[group('docker dev')]
[group('docker prod')]
[script('bash')]
up service dev='false' wait='false' *args:
    set -euo pipefail
    service=$1
    shift 3
    compose=({{ compose_command }})
    {{ if dev == "true" { "compose+=(-f docker/compose/development.yml)" } else { ":" } }}
    up_args=({{ if dev == "true" { "--build" } else { "" } }} {{ if wait == "true" { "--wait" } else { "" } }} "$@")
    "${compose[@]}" up "${up_args[@]}" "$service"

# Reset LiteLLM's PostgreSQL schema.
[group('docker dev')]
[group('docker prod')]
reset-litellm-db:
    @{{ compose_command }} exec -T lgos-db psql -U lgos -d lgos -v ON_ERROR_STOP=1 -c 'BEGIN; DROP SCHEMA IF EXISTS litellm CASCADE; CREATE SCHEMA litellm AUTHORIZATION lgos; COMMIT;'

# Sync Open WebUI Functions and LGOS Workspace Models.
[env('OPENAI_GATEWAY_BASE_URL', env('DEMO_GATEWAY_HOST_URL'))]
[group('docker dev')]
[group('docker prod')]
sync-openwebui *args:
    {{ openwebui_run }} lgos-openwebui-sync "$@"

# Register one LGOS catalog in LiteLLM; add --dev for the checkout image.
[arg('dev', long, value='true')]
[group('docker dev')]
[group('docker prod')]
[script('bash')]
sync-litellm dev='false' *args:
    set -euo pipefail
    shift
    compose=({{ compose_command }})
    {{ if dev == "true" { "compose+=(-f docker/compose/development.yml)" } else { ":" } }}
    "${compose[@]}" run --rm --no-deps --pull never lgos-model-sync "$@"

# Start and synchronize the stack; add --dev and/or --otel as needed.
[arg('dev', long, value='true')]
[arg('otel', long, value='true')]
[group('docker dev')]
[group('docker prod')]
[script('bash')]
compose dev='false' otel='false' *up_args:
    set -euo pipefail

    compose=({{ compose_command }})
    {{ if dev == "true" { "compose+=(-f docker/compose/development.yml)" } else { ":" } }}
    {{ if otel == "true" { "compose+=(-f docker/compose/otel.yml)" } else { ":" } }}

    shift 2
    up_args=({{ if dev == "true" { "--build" } else { "" } }} "$@")
    gateway_type="$("${compose[@]}" config --environment | sed -n 's/^OPENAI_GATEWAY_TYPE=//p')"
    gateway_service="$("${compose[@]}" config --services | sed -n -e '/^lgos-litellm$/p' -e '/^lgos-bifrost$/p')"

    case "$gateway_type:$gateway_service" in
        litellm:lgos-litellm|bifrost:lgos-bifrost)
            "${compose[@]}" up --wait "${up_args[@]}" "$gateway_service"
            ;;
        litellm:|bifrost:)
            "${compose[@]}" up --wait "${up_args[@]}" lgos-demo-api-a lgos-demo-api-b lgos-files-api
            ;;
        *)
            echo "OPENAI_GATEWAY_TYPE and Compose profiles select different gateways" >&2
            exit 1
            ;;
    esac

    if [[ "$gateway_type" == "litellm" ]]; then
        "${compose[@]}" run --rm --no-deps --pull never lgos-model-sync --source-url http://lgos-demo-api-a:8000/v1 --prefix lgos-a
        "${compose[@]}" run --rm --no-deps --pull never lgos-model-sync --source-url http://lgos-demo-api-b:8000/v1 --prefix lgos-b
    fi

    "${compose[@]}" up --wait "${up_args[@]}" lgos-chainlit lgos-openwebui
    if [[ -n "$gateway_service" ]]; then
        export OPENAI_GATEWAY_BASE_URL="$DEMO_GATEWAY_HOST_URL"
    fi
    {{ openwebui_run }} lgos-openwebui-sync

# Stop and remove every demo stack variant.
[group('docker dev')]
[group('docker prod')]
down *args:
    {{ compose_command }} --profile "*" down --remove-orphans "$@"
