# Exercise polling-only background lifecycle through the selected gateway.
[arg('base_url', long='base-url')]
[arg('editable', long, value='true')]
[arg('model', long)]
[group('integration')]
[script]
[timestamp]
test-background-gateway base_url='' model='' editable='false' *args:
    case "$OPENAI_GATEWAY_TYPE" in
        litellm)
            default_url="$DEMO_GATEWAY_HOST_URL/v1"
            default_model="lgos-a/background-mock"
            ;;
        bifrost)
            default_url="$DEMO_GATEWAY_HOST_URL/openai/v1"
            default_model="background-mock"
            ;;
        *)
            echo "OPENAI_GATEWAY_TYPE must be litellm or bifrost" >&2
            exit 1
            ;;
    esac
    DEMO_TEST_BACKGROUND_GATEWAY_TYPE="$OPENAI_GATEWAY_TYPE" DEMO_TEST_BACKGROUND_GATEWAY_BASE_URL="${1:-$default_url}" DEMO_TEST_BACKGROUND_GATEWAY_MODEL="${2:-$default_model}" {{ if editable == "true" { editable_api_run } else { api_run } }} pytest -m integration tests/integration/test_background_gateway.py "${@:4}"

