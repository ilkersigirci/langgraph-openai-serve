[group('integration')]
test-litellm $DEMO_TEST_LITELLM_BASE_URL=env("DEMO_TEST_LITELLM_BASE_URL") $DEMO_TEST_DIRECT_BASE_URLS=env("DEMO_TEST_DIRECT_BASE_URLS") editable='false' *args:
    {{ if editable == "true" { editable_api_run } else { api_run } }} pytest -m integration tests/integration/test_litellm_proxy.py "${@:4}"

# Start one Compose service; add --dev to build this checkout or --wait to detach.
[arg('dev', long, value='true')]
[arg('wait', long, value='true')]
[group('docker dev')]
[group('docker prod')]
up service dev='false' wait='false' *args:
    {{ if dev == "true" { compose_dev_command } else { compose_command } }} up {{ if dev == "true" { "--build" } else { "" } }} {{ if wait == "true" { "--wait" } else { "" } }} "${@:4}" "$1"

# Reset LiteLLM's PostgreSQL schema.
[group('docker dev')]
[group('docker prod')]
reset-litellm-db:
    @{{ compose_command }} exec -T lgos-db psql -U lgos -d lgos -v ON_ERROR_STOP=1 -c 'BEGIN; DROP SCHEMA IF EXISTS litellm CASCADE; CREATE SCHEMA litellm AUTHORIZATION lgos; COMMIT;'

# Sync Open WebUI Functions and LGOS Workspace Models.
[group('docker dev')]
[group('docker prod')]
sync-openwebui:
    {{ openwebui_run }} python -m lgos_openwebui.sync_functions

# Register one LGOS catalog in LiteLLM; add --dev for the checkout image.
[arg('dev', long, value='true')]
[group('docker dev')]
[group('docker prod')]
sync-litellm dev='false' *args:
    {{ if dev == "true" { compose_dev_command } else { compose_command } }} run --rm --no-deps --pull never lgos-model-sync "${@:2}"

# Start and synchronize the stack; add --dev and/or --otel as needed.
[arg('dev', long, value='true')]
[arg('otel', long, value='true')]
[group('docker dev')]
[group('docker prod')]
[script]
compose dev='false' otel='false' *up_args:
    compose=({{ if dev == "true" { compose_dev_command } else { compose_command } }} {{ if otel == "true" { "-f docker/compose/otel.yml" } else { "" } }})
    up_args=({{ if dev == "true" { "--build" } else { "" } }} "${@:3}")
    services="$("${compose[@]}" config --services)"
    gateway_service="$(sed -n -e '/^lgos-litellm$/p' -e '/^lgos-bifrost$/p' <<< "$services")"
    background_service="$(sed -n '/^lgos-background-worker$/p' <<< "$services")"
    background_services=()
    if [[ -n "$background_service" ]]; then
        background_services+=("$background_service")
    fi

    case "$OPENAI_GATEWAY_TYPE:$gateway_service" in
        litellm:lgos-litellm|bifrost:lgos-bifrost)
            "${compose[@]}" up --wait "${up_args[@]}" "$gateway_service" "${background_services[@]}"
            ;;
        litellm:|bifrost:)
            "${compose[@]}" up --wait "${up_args[@]}" lgos-postgres-mcp lgos-demo-api-a lgos-demo-api-b lgos-files-api "${background_services[@]}"
            ;;
        *)
            echo "OPENAI_GATEWAY_TYPE and Compose profiles select different gateways" >&2
            exit 1
            ;;
    esac

    if [[ "$OPENAI_GATEWAY_TYPE" == "litellm" ]]; then
        "${compose[@]}" run --rm --no-deps --pull never lgos-model-sync --source-url http://lgos-demo-api-a:8000/v1 --prefix lgos-a
        "${compose[@]}" run --rm --no-deps --pull never lgos-model-sync --source-url http://lgos-demo-api-b:8000/v1 --prefix lgos-b
    fi

    "${compose[@]}" up --wait --no-deps "${up_args[@]}" lgos-chainlit lgos-openwebui
    {{ openwebui_run }} python -m lgos_openwebui.sync_functions

# Stop and remove every demo stack variant.
[group('docker dev')]
[group('docker prod')]
down *args:
    {{ compose_command }} --profile "*" down --remove-orphans "$@"
