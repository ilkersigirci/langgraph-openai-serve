    {{ compose_command }} -f docker/compose/development.yml --profile model-sync config --quiet
    {{ compose_command }} -f docker/compose/otel.yml --profile model-sync config --quiet
    {{ compose_command }} -f docker/compose/development.yml -f docker/compose/otel.yml --profile model-sync config --quiet

# Run every demo check; add --editable inside the package checkout.
[arg('editable', long, value='true')]
[group('checks')]
check editable='false': (test editable) lint (type-check editable) compose-config

