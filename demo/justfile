[arg('port', long)]
[group('local')]
marimo editable='false' host='0.0.0.0' port='2718' *args:
    {{ if editable == "true" { editable_api_run } else { api_run } }} marimo edit --no-token --host "$2" --port "$3" "${@:4}" notebooks

