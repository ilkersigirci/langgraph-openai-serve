[arg('DEMO_API_TEST_POSTGRES_URI', long='uri')]
[group('local')]
test-postgres $DEMO_API_TEST_POSTGRES_URI=env("DEMO_API_TEST_POSTGRES_URI") editable='false':
    {{ if editable == "true" { editable_api_run } else { api_run } }} pytest -m integration tests/integration/test_postgres_interrupt_runtime.py tests/integration/test_postgres_persistent_plot_agent.py
    TEST_CHAINLIT_DATABASE_URL="$DEMO_API_TEST_POSTGRES_URI" {{ chainlit_run }} pytest -m integration tests/auth/test_oauth_tokens.py

