set default-list
set dotenv-load
set indentation := "    "
set minimum-version := "1.58.0"
set positional-arguments
set script-interpreter := ["bash", "-euo", "pipefail"]
# Preserve the caller's environment when Bash is launched over SSH.
set shell := ["bash", "--norc", "-euo", "pipefail", "-c"]

api_run := "uv run --directory api --locked"
editable_api_run := api_run + " --with-editable ../.."
files_run := "uv run --directory files_api --locked"
chainlit_run := "uv run --directory ui/chainlit_ui --locked"
openwebui_run := "uv run --directory ui/openwebui --locked"
compose_command := "docker compose -f docker/compose/demo.yml"
compose_dev_command := compose_command + " -f docker/compose/development.yml"

# Synchronize all four projects from their lockfiles.
[group('local')]
[timestamp]
sync:
    uv --directory api sync --locked
    uv --directory files_api sync --locked
    uv --directory ui/chainlit_ui sync --locked
    uv --directory ui/openwebui sync --locked

# Test every project; add --editable to overlay the parent LGOS checkout.
[arg('editable', long, value='true')]
[group('local')]
[timestamp]
test editable='false' *args:
    {{ if editable == "true" { editable_api_run } else { api_run } }} pytest "${@:2}"
    {{ files_run }} pytest "${@:2}"
    {{ chainlit_run }} pytest "${@:2}"
    {{ openwebui_run }} pytest "${@:2}"

# Open the API notebooks; add --editable to use the parent LGOS checkout.
