########### CHAINLIT ###########
CHAINLIT_APP_ROOT=src/lgos_chainlit
CHAINLIT_AUTH_SECRET=TO_BE_FILLED
DATABASE_URL=postgresql://lgos:lgos@localhost:3001/lgos

# Native Chainlit element storage (required for generated-file thread resume).
BUCKET_NAME=lgos-chainlit
APP_AWS_ACCESS_KEY=TO_BE_FILLED
APP_AWS_SECRET_KEY=TO_BE_FILLED
APP_AWS_REGION=eu-west-1
DEV_AWS_ENDPOINT=https://s3.example.com
STORAGE_EXPIRY_TIME=3600

# OAUTH_GENERIC_CLIENT_ID=TO_BE_FILLED
